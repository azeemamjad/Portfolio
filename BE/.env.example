# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend.dev-link.cloud,dev-link.cloud,www.dev-link.cloud
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL — set DATABASE_URL to use Postgres; omit to fall back to local SQLite
# If the password contains special characters (e.g. @), URL-encode them (@ → %40)
DATABASE_URL=postgresql://portflio-user:question%40671@72.62.175.219:5432/portfolio-db

# CORS / CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://dev-link.cloud,https://www.dev-link.cloud
CSRF_TRUSTED_ORIGINS=https://dev-link.cloud,https://www.dev-link.cloud

# MinIO / S3-compatible storage — set AWS_S3_ENDPOINT_URL to enable; omit all AWS_* vars for local media/
AWS_ACCESS_KEY_ID=azeem
AWS_SECRET_ACCESS_KEY=quality-time
AWS_STORAGE_BUCKET_NAME=portfolio-data
AWS_S3_ENDPOINT_URL=https://storage.dev-link.cloud
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=False

# Local media fallback (only used when AWS_S3_ENDPOINT_URL is unset)
MEDIA_URL=media/
MEDIA_ROOT=
