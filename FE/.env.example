# Backend API base URL (no trailing slash)
# Local: http://localhost:8000
# Production: https://backend.dev-link.cloud
VITE_API_URL=http://localhost:8000

# Public site origin used to build canonical URLs and Open Graph URLs
# (no trailing slash). Falls back to window.location.origin when unset.
# Production: https://dev-link.cloud
VITE_SITE_URL=http://localhost:3000

# Dev server / container port
FRONTEND_PORT=3000
